# Copy to /opt/xprism/app/.env and fill in.  (chmod 600 .env)
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=lab.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lab.example.com
SITE_URL=https://lab.example.com
DJANGO_STATIC_ROOT=/opt/xprism/static
DJANGO_TIME_ZONE=Asia/Kolkata
# set to 31536000 once HTTPS works everywhere
DJANGO_HSTS_SECONDS=0

# PostgreSQL (recommended). Leave POSTGRES_DB empty to use SQLite.
POSTGRES_DB=xprism
POSTGRES_USER=xprism
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# E-mail: sign-up verification + welcome mails and password resets.
# Without EMAIL_HOST, mails are only printed to the server log (nothing is delivered).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="XPRISM <no-reply@lab.example.com>"

# Shown in the Privacy Policy and Terms of Service: fill these in before going live
LEGAL_ORG_NAME="Aaron Innovations"
LEGAL_ORG_ADDRESS="Kolkata, India"
LEGAL_CONTACT_EMAIL=drvaraprasadsaka@gmail.com
LEGAL_GRIEVANCE_OFFICER="Dr. Vara Prasad Saka"
LEGAL_GRIEVANCE_EMAIL=drvaraprasadsaka@gmail.com
LEGAL_JURISDICTION="Kolkata, India"
LEGAL_HOSTING_LOCATION=India
DATA_RETENTION_YEARS=3
SITE_DEFAULT_LOCATION="Aaron Innovations"

# Free trial: how long one visit to an experiment lasts, and who to contact about subscriptions
TRIAL_VISIT_MAX_HOURS=3
SUBSCRIPTION_CONTACT=drvaraprasadsaka@gmail.com

# Public demo logins printed in adverts (one per role): most changes are switched off for them. See setup_demo.
SHARED_DEMO_USERNAMES=xprismdemo,xprismfaculty,xprismassistant,xprismadmin

# Mailbox (Platform > Mailbox). It sends with the EMAIL_* settings above. To receive, give it a mail account to read over IMAP.
# IMAP_USER and IMAP_PASSWORD default to EMAIL_HOST_USER and EMAIL_HOST_PASSWORD, so often only IMAP_HOST is needed.
# With Gmail or Google Workspace use imap.gmail.com and an app password.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# MAILBOX_ADDRESS=            # where replies should go; defaults to IMAP_USER
# MAILBOX_MAX_PER_DAY=200

# Free-month applications are approved automatically. Set to false to review each one under Platform > Free month.
# FREE_MONTH_AUTO_APPROVE=true
# Most applications accepted from one network address in an hour (a campus often shares one address).
# FREE_MONTH_MAX_PER_HOUR=30

# Most free-month invitations sent in 24 hours (default 200). Keep this within your mail provider's daily limit.
# FREE_YEAR_INVITES_PER_DAY=200

# Company location in invitation e-mails (the legal address for the policies is LEGAL_ORG_ADDRESS)
# SITE_COMPANY_LOCATION="Kolkata, India"

# Search engines and analytics (all optional)
# Text shown in search results and when a link is shared
# SEO_DESCRIPTION="XPRISM is a virtual pharmacology laboratory..."
# SEO_KEYWORDS="virtual pharmacology lab, B.Pharm practicals, M.Pharm practicals"
# SEO_OG_IMAGE=https://lab.example.com/assets/img/modules/hero-rota-rod.jpg
# SEO_TWITTER_HANDLE=@yourhandle
# Set true on a staging site to keep the whole site out of search engines
SEO_NOINDEX=false
# Site ownership codes from Google Search Console and Bing Webmaster Tools (the content value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Analytics (G-XXXXXXXXXX) and/or Tag Manager (GTM-XXXXXXX). Loaded only on public pages, and only after a visitor accepts.
# Before setting either, bump POLICY_VERSION in config/settings.py so users see the updated Privacy Policy.
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
